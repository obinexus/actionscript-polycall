# actionscript-polycallrc - ActionScript runtime overrides for Polycall
#
# Grammar: the core's own configuration loader -- exactly what
# `polycall config validate actionscript-polycallrc` and
# polycall_ffi_run_config accept (core docs/BINDING_ABI.md). The binding
# adds no parser and no keys: Polycall.runConfig(path) hands this path to
# polycall_ffi_run_config(path, 1).

log_level=info
max_connections=1000
network_timeout=5000
tls_enabled=false
